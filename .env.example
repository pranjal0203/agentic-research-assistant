# API Keys for Intelligent Agentic Research Assistant
# Copy this file to .env and fill in your actual credentials:
# cp .env.example .env

# 1. Groq API Key (Required for Direct Cloud LLM Mode)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# 2. Tavily API Key (Required for Live Web Search Tool)
# Get a free key at: https://app.tavily.com/
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# 3. Hugging Face Token (Optional - increases rate limits for downloading embedding weights)
# Get a free token at: https://huggingface.co/settings/tokens
# HF_TOKEN=hf_your_huggingface_token_here
